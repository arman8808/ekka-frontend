# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/hypnotherapy_db
# For production: MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/hypnotherapy_db

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRE=7d

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000

# Admin Credentials (for initial setup)
ADMIN_EMAIL=admin@ekaausa.com
ADMIN_PASSWORD=admin123
